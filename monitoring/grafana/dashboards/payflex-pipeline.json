{
  "uid": "payflex-pipeline",
  "title": "PayFlex - indicateurs du pipeline CI/CD",
  "tags": [
    "payflex",
    "ci-cd",
    "quality-gate"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "branch",
        "label": "Branche",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(payflex_pipeline_last_run_timestamp_seconds, branch)",
          "refId": "branch"
        },
        "definition": "label_values(payflex_pipeline_last_run_timestamp_seconds, branch)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Dernière exécution : branche $branch",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
