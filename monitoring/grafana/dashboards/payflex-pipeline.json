        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "BLOQUÉ",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "AVERTISSEMENT",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "SUCCÈS",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(payflex_pipeline_status{branch=\"$branch\",status=\"SUCCESS\"}) * 2 + max(payflex_pipeline_status{branch=\"$branch\",status=\"SUCCESS_WITH_WARNINGS\"})",
          "instant": true
        }
      ]
    },
